#include<stdio.h>
int main()
{
    int i, j, k, n1;
    printf("no. of rows = ");
    scanf("%d", &n1);
    for(i = 1; i <= n1; i++)
    {
        for(k = 1; k <= n1 - i; k++)
        {
            printf(" ");
        }
        for(j = 1; j <= i; j++)
        {
            printf("* ");
        }
        printf("\n");
    }
    return 0;
}
